{
  "rules": {
    "rooms": {
      "$room": {
        "messages": {
          ".read": true,
          ".write": true,
          "$msg": {
            ".validate": "newData.hasChildren(['uid','name','ts']) && newData.child('name').isString() && newData.child('name').val().length <= 24 && (!newData.hasChild('text') || newData.child('text').val().length <= 1000) && (!newData.hasChild('image') || newData.child('image').val().length <= 1600000)"
          }
        },
        "presence": {
          ".read": true,
          ".write": true
        }
      }
    }
  }
}
